{
  "name": "szopero",
  "version": "2.0.3.1",
  "description": "SZOPERO - launcher gier SzopikPraczekYT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "installer": "electron-builder --win nsis",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "patch-package": "^8.0.1"
  },
  "build": {
    "appId": "pl.szopikpraczekyt.szopero",
    "productName": "SZOPERO",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "package.json",
      "game-start-preload.js"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icons/logo.ico"
    },
    "portable": {
      "artifactName": "SZOPERO-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "SZOPERO-${version}-Setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icons/logo.ico",
      "uninstallerIcon": "assets/icons/logo.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "SzopikPraczekYt",
      "repo": "SZOPERO"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
